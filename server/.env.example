# ============================================
# Cookathon / Recipia — Environment Variables
# ============================================
# Copy this file to .env and fill in real values:
#   cp .env.example .env
# ============================================

# Server
PORT=5050

# Database — Neon PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Authentication — used to sign and verify JWTs
# Generate a random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_32_char_random_secret_here

# DeepSeek AI — used for recipe formatting, title generation, recommendations, moderation
DEEPSEEK_API_KEY=sk-your-deepseek-key

# Hugging Face — used for toxic-bert comment moderation
HF_API_KEY=hf_your-huggingface-key

# OpenAI — (optional, not currently used in core routes)
OPENAI_API_KEY=sk-your-openai-key

# CORS — frontend origin (set to production URL when deploying)
# Used after S1-08 lands
# ALLOWED_ORIGIN=http://localhost:5173